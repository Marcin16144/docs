################################################################################
# Kompendium - repo ignore rules
#
# A large static HTML knowledge base (tracked) plus a .NET 8 / Visual Studio
# solution under src/ (build output ignored). Code-build patterns are scoped to
# src/ on purpose so they can never shadow content folders that happen to be
# named "bin", "arm", "release", "publish" etc. (e.g. house/publish/).
################################################################################

# ---------------------------------------------------------------------------
# .NET / Visual Studio build output  (solution lives under src/)
# ---------------------------------------------------------------------------
src/**/[Bb]in/
src/**/[Oo]bj/
src/**/[Dd]ebug/
src/**/[Dd]ebugPublic/
src/**/[Rr]elease/
src/**/[Rr]eleases/
src/**/x64/
src/**/x86/
src/**/[Ww][Ii][Nn]32/
src/**/[Aa][Rr][Mm]/
src/**/[Aa][Rr][Mm]64/
src/**/[Bb]uild/
src/**/[Bb]ld/
src/**/[Oo]ut/
src/**/[Ll]og/
src/**/[Ll]ogs/
src/**/[Tt]est[Rr]esult*/
src/**/*.binlog
src/**/*.tlog
src/**/*.coverage
src/**/*.coveragexml
src/**/*.nupkg
src/**/*.snupkg
src/**/[Pp]ackages/
src/**/project.lock.json
src/**/project.fragment.lock.json
src/**/artifacts/

# ---------------------------------------------------------------------------
# Visual Studio IDE state
# ---------------------------------------------------------------------------
.vs/
*.user
*.userosscache
*.suo
*.sln.docstates
*.userprefs
*.[Pp]ublish.xml
.vshistory/
.vsconfig

# ReSharper / Rider
_ReSharper*/
*.[Rr]e[Ss]harper
.idea/
*.DotSettings.user

# ---------------------------------------------------------------------------
# Claude Code scaffolding (settings + ephemeral worktrees) - never commit worktrees
# ---------------------------------------------------------------------------
/.claude
**/.claude/worktrees/

# ---------------------------------------------------------------------------
# Kompendium build outputs (root only - never matches nested content folders)
# ---------------------------------------------------------------------------
# Desktop single-file publish (tools/build-desktop.ps1)
/publish/
# Web deployment bundle (tools/build-web.ps1)
/dist/
/kompendium-web.zip

# Indexer gap report (regenerated). catalog.json / sections.json / relations.json
# are the deployable data layer and stay TRACKED on purpose.
values/data/_report.json

# ---------------------------------------------------------------------------
# OS / editor cruft
# ---------------------------------------------------------------------------
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
*~
*.swp
*.tmp
