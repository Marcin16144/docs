<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyTitle>Kompendium — Baza wiedzy</AssemblyTitle>
    <Product>Kompendium</Product>
    <Version>1.0.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Self-contained single-file publish: the resulting .exe carries the .NET 8
         runtime and all managed/native dependencies, so it runs on a clean Windows
         box with no SDK/runtime install. RuntimeIdentifiers (plural) declares the
         target without forcing RID resolution on a plain build; the publish script
         turns self-contained on at the command line. The only OS prerequisite is
         the Evergreen WebView2 Runtime, pre-installed on Windows 10/11. -->
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SatelliteResourceLanguages>en;pl</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kompendium.Core\Kompendium.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3856.49" />
  </ItemGroup>

</Project>
